<view class="tab-bar">
  <view class="tab-item {{selected === index ? 'active' : ''}}"
        wx:for="{{list}}"
        wx:key="index"
        bindtap="switchTab"
        data-index="{{index}}"
        data-path="{{item.pagePath}}">
    
    <view class="icon-box">
      <!-- <view class="badge" wx:if="{{item.badge > 0}}">{{item.badge > 99 ? '99+' : item.badge}}</view> -->
      <image src="{{selected === index ? item.selectedIconPath : item.iconPath}}" class="icon"/>
    </view>
    
    <text class="text">{{item.text}}</text>
  </view>
</view>