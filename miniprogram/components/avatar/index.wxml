<image
  wx:if="{{src}}"
  class="avatar-img"
  src="{{src}}"
  mode="aspectFill"
  style="width:{{size}}rpx;height:{{size}}rpx;"
></image>
<view
  wx:else
  class="avatar-text"
  style="width:{{size}}rpx;height:{{size}}rpx;background:{{bg}};font-size:{{fontSize}}rpx;"
>
  <text>{{initial}}</text>
</view>
