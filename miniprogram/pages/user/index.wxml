<view class="user-page">
  <!-- 头部 -->
  <view class="user-header">
  <view class="avatar">
    <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill"></image>
    <text wx:else class="avatar-text">{{avatarText}}</text>
  </view>

  <view class="username">
    <view class="icon-placeholder"></view>
    <text class="username-text">{{nickname}}</text>
    <image class="user-icon-img" src="/static/images/user/settings.png" mode="aspectFit"    bindtap="goSettings"></image>
  </view>

  <view class="user-id" bindtap="copyId">
    <view class="icon-placeholder"></view>
    <text class="user-id-text">账号ID：{{shortId}}</text>
    <image class="user-icon-img" src="/static/images/user/replication.png" mode="aspectFit"></image>
  </view>
</view>

  <!-- 第一组菜单 -->
  <view class="menu-block">
    <view class="menu-item" bindtap="goDraft">
      <image class="menu-icon-img" src="/static/images/user/icon_draft.png" mode="aspectFit"></image>
      <view class="menu-text">我的草稿</view>
      <view class="menu-arrow">></view>
    </view>
  </view>

  <!-- 第二组菜单 -->
  <view class="menu-block">
    <view class="menu-item" bindtap="goHistory">
      <image class="menu-icon-img" src="/static/images/user/icon_history.png" mode="aspectFit"></image>
      <view class="menu-text">浏览记录</view>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goCollect">
      <image class="menu-icon-img" src="/static/images/user/icon_collect.png" mode="aspectFit"></image>
      <view class="menu-text">我的收藏</view>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goPublicWork">
      <image class="menu-icon-img" src="/static/images/user/icon_public.png" mode="aspectFit"></image>
      <view class="menu-text">公开作品</view>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goPrivateWork">
      <image class="menu-icon-img" src="/static/images/user/icon_private.png" mode="aspectFit"></image>
      <view class="menu-text">私有作品</view>
      <view class="menu-arrow">></view>
    </view>
  </view>

  <!-- 第三组菜单 -->
  <view class="menu-block">
    <view class="menu-item" bindtap="goMiniCode">
      <image class="menu-icon-img" src="/static/images/user/icon_qrcode.png" mode="aspectFit"></image>
      <view class="menu-text">小程序码</view>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <image class="menu-icon-img" src="/static/images/user/icon_setting.png" mode="aspectFit"></image>
      <view class="menu-text">个人设置</view>
      <view class="menu-arrow">></view>
    </view>
  </view>

  <view class="version">V1.0.0</view>
</view>