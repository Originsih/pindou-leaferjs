page {
  background-color: rgba(255, 243, 204, 1) 0%;
}

.user-page {
  padding-bottom: 120rpx;
}

/* 头部 */
.user-header {
  background: linear-gradient(#fff2cc, #f8f4e8);
  text-align: center;
  padding: 160rpx 30rpx 30rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: #ffd33d;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-text {
  font-size: 60rpx;
  color: #ffffff;
  font-weight: bold;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 昵称行 */
.username {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.username .icon-placeholder {
  width: 30rpx;
  margin-left: 12rpx;
  visibility: hidden;
}

.username .user-icon-img {
  width: 30rpx;
  height: 30rpx;
  margin-left: 12rpx;
}

/* ID 行 */
.user-id {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #888888;
}

.user-id .icon-placeholder {
  width: 28rpx;
  margin-left: 10rpx;
  visibility: hidden;
}

.user-id .user-icon-img {
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
}

/* 菜单块 */
.menu-block {
  margin: 22rpx 34rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f3f3f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-img {
  width: 54rpx;
  height: 54rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(48, 63, 82, 1);
  line-height: 40rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #bbbbbb;
}

.version {
  text-align: center;
  font-size: 28rpx;
  color: #bbbbbb;
  margin-top: 40rpx;
}