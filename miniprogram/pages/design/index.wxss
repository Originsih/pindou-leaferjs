page {
    background-color: #f9f5e9;
  }
  /* 导航栏 */
  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 88rpx;
    background: #ffffff;
    position: relative;
  }
  .nav-title {
    font-size: 36rpx;
    font-weight: bold;
  }
  .nav-space {
    width: 160rpx;
    position: absolute;
    right: 0;
    height: 100%;
  }
  
  /* 主体区域 */
  .page-body {
    padding: 30rpx;
  }
  .card-item {
    background: #fff;
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    padding: 32rpx;
    margin-bottom: 24rpx;
  }
  .card-icon {
    width: 48px;
    height: 48px;
    margin-right: 30rpx;
  }
  .card-info {
    flex: 1;
  }
  .card-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #222;
  }
  .hot-tag {
    background: #ff6b35;
    color: #fff;
    font-size: 20rpx;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    margin-left: 12rpx;
  }
  .card-desc {
    font-size: 26rpx;
    color: #888;
    margin-top: 8rpx;
  }
  .tip-text {
    text-align: center;
    color: #aaa;
    font-size: 30rpx;
    margin-top: 80rpx;
  }