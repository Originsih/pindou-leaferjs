.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #f9f5e9;
  width: 100vw; /* 锁死页面宽度 */
  overflow: hidden; /* 防止外层溢出 */
}

/* 提示条 */
.tip-box {
  margin: 24rpx 24rpx 0;
  background: rgba(255, 240, 194, 1);
  border: 1rpx solid rgba(250, 192, 17, 1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  flex-shrink: 0;
}
.tip-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 24rpx;
}
.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: rgba(250, 192, 17, 1);
}
.tip-close {
  font-size: 36rpx;
  padding: 0 8rpx;
  color: rgba(250, 192, 17, 1);
}

/* 核心：强制 scroll-view 占满宽度 */
.card-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%; 
}

.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ================= 核心修复：瀑布流布局 ================= */
.waterfall-wrap {
  display: flex;
  justify-content: space-between; 
  align-items: flex-start;
  width: 100%; /* 强制瀑布流容器占满 */
}
.col-left,
.col-right {
  width: 48.5%; 
  display: flex;
  flex-direction: column;
  gap: 24rpx; 
  flex-shrink: 0; 
}
/* ======================================================= */

.menu-icon-img {
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

/* 强制卡片内部为 flex 纵向布局 */
.paper-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 3rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.paper-cover {
  width: 100%;
  display: block;
  /* 加上这行防止有的特别长的图片把卡片拉得太夸张 */
  max-height: 400rpx; 
  object-fit: cover;
}

/* 没有封面时的占位，避免出现破图 */
.cover-empty {
  height: 240rpx;
  background: #f3f3f3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #bbb;
  box-sizing: border-box;
}

/* 标题+热度 左右排列 */
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
  padding: 16rpx 12rpx 8rpx 16rpx;
  box-sizing: border-box;
}

.paper-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.3;
  flex: 1;
  min-width: 0; 
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; 
  overflow: hidden;
  /* 把内边距移到 title-row 上了 */
}

.paper-meta {
  flex-shrink: 0;
}

.bean-num {
  display: flex;
  align-items: center;
  white-space: nowrap;
  font-size: 24rpx;
  color: #dd4444;
  padding-right: 10rpx;
}

.paper-author {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: #777;
  padding: 0 16rpx 20rpx 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.author-text {
  font-size: 20rpx;
  color: rgba(48, 63, 82, 1);
  flex-shrink: 0;
}

.author-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0; 
  overflow: hidden;
}

.author-left text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis; 
}

.author-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
  background: #eee;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}