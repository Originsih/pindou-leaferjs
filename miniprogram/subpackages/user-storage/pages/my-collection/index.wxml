<!-- 顶部提示公告条 -->
<view wx:if="{{showTip}}" class="tip-box">
  <image class="tip-icon" src="/static/images/Icon/Warnings.png" mode="aspectFit"></image>
  <text class="tip-text">长按图纸可取消收藏</text>
  <view class="tip-close" bindtap="closeTip">×</view>
</view>

<!-- 空状态 -->
<view class="empty" wx:if="{{leftList.length === 0 && rightList.length === 0 && !loading}}">
  <text>还没有收藏任何图纸哦~</text>
</view>

<!-- 卡片滑动区域 -->
<scroll-view class="card-scroll" scroll-y="true" enhanced show-scrollbar="{{false}}" wx:else>
  <view class="container">
    <view class="waterfall-wrap">
      <!-- 左列 -->
      <view class="col-left">
        <view
          class="paper-item"
          wx:for="{{leftList}}"
          wx:key="id"
          bindtap="goDetail"
          bindlongpress="handleLongPress"
          data-item="{{item}}"
        >
          <image wx:if="{{item.cover}}" class="paper-cover" src="{{item.cover}}" mode="widthFix"></image>
          <view wx:else class="paper-cover cover-empty"><text>暂无预览</text></view>
          <view class="title-row">
            <view class="paper-title">{{item.title}}</view>
            <view class="paper-meta">
              <view class="bean-num">
                <image class="menu-icon-img" src="/static/images/Icon/1.png" mode="aspectFit"></image>{{item.beanCount}}
              </view>
            </view>
          </view>
          <view class="paper-author">
            <view class="author-left">
              <avatar src="{{item.avatar}}" name="{{item.userNick}}" size="44" />
              <text>{{item.userNick}}</text>
            </view>
            <text class="author-text">{{item.useCount}}人用</text>
          </view>
        </view>
      </view>

      <!-- 右列 -->
      <view class="col-right">
        <view
          class="paper-item"
          wx:for="{{rightList}}"
          wx:key="id"
          bindtap="goDetail"
          bindlongpress="handleLongPress"
          data-item="{{item}}"
        >
          <image wx:if="{{item.cover}}" class="paper-cover" src="{{item.cover}}" mode="widthFix"></image>
          <view wx:else class="paper-cover cover-empty"><text>暂无预览</text></view>
          <view class="title-row">
            <view class="paper-title">{{item.title}}</view>
            <view class="paper-meta">
              <view class="bean-num">
                <image class="menu-icon-img" src="/static/images/Icon/1.png" mode="aspectFit"></image>{{item.beanCount}}
              </view>
            </view>
          </view>
          <view class="paper-author">
            <view class="author-left">
              <avatar src="{{item.avatar}}" name="{{item.userNick}}" size="44" />
              <text>{{item.userNick}}</text>
            </view>
            <text class="author-text">{{item.useCount}}人用</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>