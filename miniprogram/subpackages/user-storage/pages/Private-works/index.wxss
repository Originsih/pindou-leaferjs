page {
  background: #f5f0e6;
  min-height: 100vh;
}

.page-wrap {
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 160rpx 0;
}

.draft-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.draft-item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  align-items: center;
}

.draft-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.empty-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 24rpx;
}

.draft-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.draft-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-tag-wrap {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #d4a017;
  background: #fff8e1;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ffe082;
}

.draft-update {
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.loading-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 40rpx 0;
}