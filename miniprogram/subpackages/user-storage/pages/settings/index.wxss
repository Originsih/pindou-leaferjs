page {
  height: 100%;
  background: #f9f5e9;
}

.page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-wrap {
  flex-shrink: 0;
  background: #fff;
}
.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
}
.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}
.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.nav-space {
  width: 60rpx;
}

/* 设置卡片 */
.setting-card {
  margin: 30rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 0 32rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 120rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.setting-item:last-child {
  border-bottom: none;
}

.item-label {
  font-size: 30rpx;
  color: #333;
}

/* 头像按钮去默认样式 */
.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  line-height: normal;
}
.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin-right: 16rpx;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 管理员入口 */
.admin-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.admin-tip {
  font-size: 22rpx;
  color: #ff6b35;
  background: #fff1ea;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

/* 昵称输入框 */
.nickname-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #333;
  margin-left: 40rpx;
}

/* 底部按钮 */
.bottom-wrap {
  margin-top: auto;
  padding: 40rpx 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.save-btn {
  height: 96rpx;
  background: #ffd54f;
  color: #333;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 213, 79, 0.4);
}

.btn-hover {
  background: #ffc107;
  transform: scale(0.98);
}