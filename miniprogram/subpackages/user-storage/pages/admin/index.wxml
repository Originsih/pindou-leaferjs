<view class="page">
  <!-- ========== 未登录：口令门 ========== -->
  <view class="login-box" wx:if="{{!unlocked}}">
    <view class="login-lock">🔒</view>
    <text class="login-title">审核管理</text>
    <text class="login-desc">请输入管理口令后进入</text>

    <input
      class="pin-input"
      password="{{true}}"
      placeholder="管理口令"
      placeholder-class="pin-placeholder"
      value="{{pinInput}}"
      bindinput="onPinInput"
      confirm-type="done"
      bindconfirm="doLogin"
    />

    <text class="pin-error" wx:if="{{pinError}}">{{pinError}}</text>

    <view class="login-btn {{pinInput && !logging ? '' : 'disabled'}}" bindtap="doLogin">
      <text>{{logging ? '验证中...' : '进入审核'}}</text>
    </view>
  </view>

  <!-- ========== 已登录 ========== -->
  <block wx:else>
    <!-- 页签 -->
    <view class="tab-bar">
      <view
        class="tab-item {{tab === 'review' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="review"
      >
        <text>待审核</text>
        <text class="tab-count" wx:if="{{pendingWorks.length}}">{{pendingWorks.length}}</text>
      </view>
      <view
        class="tab-item {{tab === 'report' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="report"
      >
        <text>举报</text>
        <text class="tab-count" wx:if="{{reports.length}}">{{reports.length}}</text>
      </view>
      <view
        class="tab-item {{tab === 'config' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="config"
      >
        <text>发布设置</text>
      </view>
      <view
        class="tab-item {{tab === 'admin' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="admin"
      >
        <text>管理员</text>
      </view>
      <text class="tab-logout" bindtap="doLogout">退出</text>
    </view>

    <view class="tip-bar">
      <text class="tip-text">刷新列表</text>
      <text class="tip-refresh" bindtap="load">刷新</text>
    </view>

    <view class="empty" wx:if="{{error}}">
      <text class="empty-title">加载失败</text>
      <text class="empty-desc">{{error}}</text>
    </view>

    <!-- ========== 待审核作品 ========== -->
    <block wx:elif="{{tab === 'review'}}">
      <view class="empty" wx:if="{{!loading && pendingWorks.length === 0}}">
        <text class="empty-title">暂无待审核作品</text>
        <text class="empty-desc">全部处理完啦 👍</text>
      </view>

      <view class="report-list" wx:else>
        <view class="report-item" wx:for="{{pendingWorks}}" wx:key="_id">
          <view class="report-head" bindtap="openWork" data-workid="{{item._id}}">
            <image
              wx:if="{{item.cover}}"
              class="report-cover"
              src="{{item.cover}}"
              mode="aspectFill"
            ></image>
            <view wx:else class="report-cover cover-empty"><text>无图</text></view>

            <view class="report-info">
              <text class="report-title">{{item.title || '未命名作品'}}</text>
              <view class="report-meta">
                <text class="badge badge-pending">待审核</text>
                <text class="badge badge-info">{{item.gridSize || 34}}×{{item.gridSize || 34}}</text>
                <text class="badge badge-info" wx:if="{{item.totalBeans}}">{{item.totalBeans}}颗</text>
              </view>
              <text class="report-time">{{item.authorNick || '拼豆爱好者'}} · {{item.timeText}}</text>
            </view>
          </view>

          <view class="report-actions">
            <view
              class="act act-ok"
              bindtap="approveWork"
              data-workid="{{item._id}}"
            >通过</view>
            <view
              class="act act-danger"
              bindtap="rejectWork"
              data-workid="{{item._id}}"
            >不通过</view>
          </view>
        </view>
      </view>
    </block>

    <!-- ========== 举报处理 ========== -->
    <block wx:elif="{{tab === 'report'}}">
      <view class="empty" wx:if="{{!loading && reports.length === 0}}">
        <text class="empty-title">暂无待处理举报</text>
        <text class="empty-desc">一切正常 👍</text>
      </view>

      <view class="report-list" wx:else>
        <view class="report-item" wx:for="{{reports}}" wx:key="_id">
          <view class="report-head" bindtap="openWork" data-workid="{{item.workId}}">
            <image
              wx:if="{{item.workCover}}"
              class="report-cover"
              src="{{item.workCover}}"
              mode="aspectFill"
            ></image>
            <view wx:else class="report-cover cover-empty"><text>无图</text></view>

            <view class="report-info">
              <text class="report-title">{{item.workTitle}}</text>
              <view class="report-meta">
                <text class="badge badge-reason">{{item.reason}}</text>
                <text class="badge badge-hidden" wx:if="{{item.workHidden}}">已下架</text>
                <text class="badge badge-gone" wx:if="{{!item.workExists}}">作品已删除</text>
              </view>
              <text class="report-detail" wx:if="{{item.detail}}">补充：{{item.detail}}</text>
              <text class="report-time">{{item.timeText}}</text>
            </view>
          </view>

          <view class="report-actions" wx:if="{{item.workExists}}">
            <view
              wx:if="{{!item.workHidden}}"
              class="act act-warn"
              bindtap="handleReport"
              data-workid="{{item.workId}}"
              data-action="hide"
            >下架</view>
            <view
              wx:else
              class="act act-ok"
              bindtap="handleReport"
              data-workid="{{item.workId}}"
              data-action="restore"
            >恢复上架</view>

            <view
              class="act act-danger"
              bindtap="handleReport"
              data-workid="{{item.workId}}"
              data-action="delete"
            >删除</view>
          </view>
        </view>
      </view>
    </block>

    <!-- ========== 发布设置 ========== -->
    <block wx:elif="{{tab === 'config'}}">
      <view class="cfg-card">
        <view class="cfg-row">
          <view class="cfg-info">
            <text class="cfg-title">允许普通用户发布作品</text>
            <text class="cfg-desc">关闭后只有管理员能发布，普通用户仍可编辑和保存草稿</text>
          </view>
          <switch
            checked="{{cfg.allowUserPublish}}"
            bindchange="onSwitchUserPublish"
            color="#ff6b35"
          />
        </view>

        <view class="cfg-row {{cfg.allowUserPublish ? '' : 'cfg-off'}}">
          <view class="cfg-info">
            <text class="cfg-title">允许普通用户发布「公开」作品</text>
            <text class="cfg-desc">关闭后普通用户只能存私有作品，不会出现在广场</text>
          </view>
          <switch
            checked="{{cfg.allowUserPublicPublish}}"
            disabled="{{!cfg.allowUserPublish}}"
            bindchange="onSwitchUserPublicPublish"
            color="#ff6b35"
          />
        </view>
      </view>

      <view class="maint-tip" style="margin: 24rpx 32rpx;">
        管理员账号始终可以发布，不受这两个开关限制。改动立即生效。
      </view>
      <view class="maint-tip" style="margin: 0 32rpx; color: #ff6b35;">
        提示：你自己是管理员，所以关掉开关后你仍然能发布。
        想验证效果，请用另一个非管理员账号（或加为体验成员）测试。
      </view>
    </block>

    <!-- ========== 管理员名单 ========== -->
    <block wx:else>
      <!-- 查找用户 -->
      <view class="admin-search">
        <input
          class="admin-search-input"
          placeholder="输入昵称 / 账号ID / openid"
          placeholder-class="pin-placeholder"
          value="{{userKeyword}}"
          bindinput="onUserKeywordInput"
          confirm-type="search"
          bindconfirm="doFindUser"
        />
        <view class="admin-search-btn" bindtap="doFindUser">{{findingUser ? '查找中' : '查找'}}</view>
      </view>

      <!-- 搜索结果 -->
      <view class="report-list" wx:if="{{userResults.length}}">
        <view class="user-row" wx:for="{{userResults}}" wx:key="openid">
          <avatar src="{{item.avatar}}" name="{{item.nickname}}" size="72" />
          <view class="user-info">
            <text class="user-nick">{{item.nickname}}</text>
            <text class="user-id" wx:if="{{item.shortId}}">{{item.shortId}}</text>
          </view>
          <view
            class="user-add"
            bindtap="addAdmin"
            data-openid="{{item.openid}}"
            data-nickname="{{item.nickname}}"
          >添加</view>
        </view>
      </view>
      <view class="empty" wx:if="{{userKeyword && !findingUser && userResults.length === 0}}">
        <text class="empty-desc">没找到该用户，请确认对方已经打开过小程序</text>
      </view>

      <!-- 我自己 -->
      <view class="self-card">
        <view class="self-info">
          <text class="self-label">当前登录</text>
          <text class="self-openid">{{selfInfo.openid}}</text>
        </view>
        <text class="self-tag self-tag-ok" wx:if="{{selfInfo.inCollection}}">名单内</text>
        <text class="self-tag self-tag-boot" wx:elif="{{selfInfo.viaBootstrap}}">内置授权</text>
        <view class="self-btn" wx:if="{{!selfInfo.inCollection}}" bindtap="selfEnroll">加入名单</view>
      </view>

      <!-- 当前管理员 -->
      <view class="section-label">当前管理员（{{admins.length}}）</view>
      <view class="report-list">
        <view class="admin-row" wx:for="{{admins}}" wx:key="_openid">
          <view class="admin-info">
            <text class="admin-name">{{item.name}}</text>
            <text class="admin-openid">{{item._openid}}</text>
          </view>
          <text class="admin-self" wx:if="{{item.isSelf}}">本人</text>
          <view
            wx:else
            class="admin-del"
            bindtap="removeAdmin"
            data-openid="{{item._openid}}"
            data-name="{{item.name}}"
          >移除</view>
        </view>
        <view class="empty" wx:if="{{admins.length === 0}}">
          <text class="empty-desc">名单为空，当前使用内置引导名单授权</text>
        </view>
      </view>

      <!-- 内置引导名单 -->
      <block wx:if="{{bootstrapAdmins.length}}">
        <view class="section-label">内置引导名单</view>
        <view class="report-list">
          <view class="admin-row" wx:for="{{bootstrapAdmins}}" wx:key="*this">
            <text class="admin-openid">{{item}}</text>
          </view>
        </view>
      </block>

      <view class="maint-tip" style="margin: 20rpx 32rpx;">
        添加第一个管理员后，授权以「当前管理员」名单为准；内置名单只在名单为空时生效。
      </view>
    </block>

    <!-- 数据维护 -->
    <view class="maint-box">
      <view class="maint-btn" bindtap="migrateDrafts">迁移历史草稿到 drafts 集合</view>
      <text class="maint-tip">从旧版本升级后执行一次即可；每批最多 100 条，数据多可重复点</text>
    </view>

    <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
  </block>
</view>
