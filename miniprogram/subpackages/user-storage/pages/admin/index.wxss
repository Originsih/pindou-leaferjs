.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ================= 口令登录门 ================= */
.login-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx 0;
}

.login-lock {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.pin-input {
  width: 100%;
  height: 92rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e5e5;
  text-align: center;
  letter-spacing: 4rpx;
}

.pin-placeholder {
  color: #bbb;
  letter-spacing: 0;
}

.pin-error {
  font-size: 24rpx;
  color: #e64340;
  margin-top: 20rpx;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 40rpx;
  background: #ff6b35;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #fff;
}

.login-btn.disabled {
  background: #ffb79a;
}

/* 顶部说明 */
.tip-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tip-left,
.tip-right {
  display: flex;
  align-items: center;
}

.tip-right {
  gap: 28rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.tip-refresh {
  font-size: 26rpx;
  color: #ff6b35;
}

.tip-logout {
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
  padding: 0 60rpx;
}

/* 举报列表 */
.report-list {
  padding: 24rpx;
}

.report-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.report-head {
  display: flex;
  padding: 24rpx;
}

.report-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #bbb;
}

.report-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.report-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.report-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.badge-reason {
  color: #e64340;
  background: #fdeceb;
}

.badge-hidden {
  color: #999;
  background: #f0f0f0;
}

.badge-gone {
  color: #999;
  background: #f0f0f0;
}

.report-detail {
  font-size: 22rpx;
  color: #888;
  margin-top: 10rpx;
  line-height: 1.4;
}

.report-time {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 10rpx;
}

/* 操作按钮 */
.report-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.act {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
}

.act + .act {
  border-left: 1rpx solid #f0f0f0;
}

.act-warn {
  color: #ff9500;
}

.act-ok {
  color: #07c160;
}

.act-danger {
  color: #e64340;
}

.loading-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 30rpx 0;
}

/* ================= 页签 ================= */
.tab-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  padding: 0 16rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 64rpx;
  height: 4rpx;
  background: #ff6b35;
  border-radius: 2rpx;
}

.tab-count {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ff6b35;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
  font-weight: normal;
}

.tab-logout {
  font-size: 24rpx;
  color: #999;
  padding: 0 16rpx;
}

/* 审核相关徽标 */
.badge-pending {
  color: #b8860b;
  background: #fff8e6;
}

.badge-info {
  color: #666;
  background: #f3f3f3;
}
/* ================= 数据维护 ================= */
.maint-box {
  margin: 40rpx 24rpx 10rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.maint-btn {
  font-size: 26rpx;
  color: #ff6b35;
  padding: 16rpx 0;
}

.maint-tip {
  font-size: 20rpx;
  color: #aaa;
  text-align: center;
  line-height: 1.5;
}
/* ================= 管理员名单 ================= */
.admin-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.admin-search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.admin-search-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 26rpx;
  border-radius: 36rpx;
}

.section-label {
  font-size: 24rpx;
  color: #999;
  padding: 28rpx 32rpx 12rpx;
}

.user-row,
.admin-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.user-info,
.admin-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.user-nick,
.admin-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-id,
.admin-openid {
  font-size: 20rpx;
  color: #aaa;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-add {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.admin-self {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ef;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.admin-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #e64340;
  padding: 8rpx 20rpx;
  border: 1rpx solid #f5c2c0;
  border-radius: 8rpx;
}
/* 当前登录者状态卡 */
.self-card {
  display: flex;
  align-items: center;
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.self-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.self-label {
  font-size: 24rpx;
  color: #999;
}

.self-openid {
  font-size: 22rpx;
  color: #333;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.self-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
}

.self-tag-ok {
  color: #07c160;
  background: #e8f8ef;
}

.self-tag-boot {
  color: #b8860b;
  background: #fff8e6;
}

.self-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  background: #ff6b35;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}
/* ================= 发布设置 ================= */
.cfg-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.cfg-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.cfg-row:last-child {
  border-bottom: none;
}

.cfg-row.cfg-off {
  opacity: 0.45;
}

.cfg-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-right: 20rpx;
}

.cfg-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.cfg-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.5;
}