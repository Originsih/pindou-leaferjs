page {
  background: #f9f5e9;
  height: 100%;
}
.page {
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qrcode-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
}
.qr-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}
.qr-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 50rpx;
}
.qr-img-box {
  width: 400rpx;
  height: 400rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  padding: 20rpx;
}
.qr-img {
  width: 100%;
  height: 100%;
}
.qr-loading {
  width: 400rpx;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}
.user-info {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #666;
  background: #fff8e1;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}
.action-wrap {
  width: 100%;
  margin-top: 80rpx;
}
.save-btn {
  width: 100% !important;
  background: #ffd54f;
  color: #333;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 48rpx;
  padding: 24rpx 0;
  line-height: 1;
}
.save-btn::after {
  border: none;
}