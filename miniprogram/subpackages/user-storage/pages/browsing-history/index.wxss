page {
  background: #f9f5e9;
  height: 100%;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶部清空栏 */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  flex-shrink: 0;
}
.tip {
  font-size: 28rpx;
  color: #666;
}
.clear-btn {
  font-size: 28rpx;
  color: #ff6b35;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 滚动区域 */
.card-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.container {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: 200rpx;
}

/* ================= 终极防挤压瀑布流 ================= */
.waterfall-wrap {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
}

.col-left,
.col-right {
  /* 使用 calc 严格限制宽度，绝对不会被挤压 */
  width: calc(50% - 12rpx); 
  display: flex;
  flex-direction: column;
  gap: 24rpx; 
  flex-shrink: 0; 
}
/* ==================================================== */

.paper-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 3rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.paper-cover {
  width: 100%;
  height: 240rpx; /* 强制给个高度，防止原图尺寸乱了卡片比例 */
  object-fit: cover;
  display: block;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
  padding: 16rpx 12rpx 8rpx 16rpx;
  box-sizing: border-box;
}

.paper-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.3;
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.paper-meta {
  flex-shrink: 0;
}

.bean-num {
  display: flex;
  align-items: center;
  white-space: nowrap;
  font-size: 24rpx;
  color: #dd4444;
  padding-right: 10rpx;
}
.menu-icon-img {
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
}

.paper-author {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: #777;
  padding: 0 16rpx 20rpx 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.author-text {
  font-size: 20rpx;
  color: rgba(48, 63, 82, 1);
  flex-shrink: 0;
}

.author-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.author-left text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.author-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
  background: #eee;
}
/* 没有封面时的占位，避免出现破图 */
.cover-empty {
  height: 240rpx;
  background: #f3f3f3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #bbb;
  box-sizing: border-box;
}