<view class="page">
  <!-- 顶部导航栏 -->
  <view class="nav-wrap" style="padding-top:{{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">‹</text>
      </view>
      <view class="nav-title">{{_editingId ? '更新作品' : '发布作品'}}</view>
      <view class="nav-space"></view>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-card">
    <!-- 图纸作品 -->
    <view class="form-item">
      <text class="form-label">图纸作品</text>
      <image class="work-cover" src="{{workImage}}" mode="aspectFit"></image>
    </view>

    <!-- 作品名称 -->
    <view class="form-item">
      <text class="form-label">作品名称</text>
      <input class="form-input" placeholder="请输入作品名称" value="{{workName}}" bindinput="onNameInput" maxlength="30" />
    </view>

    <!-- 是否公开 -->
    <view class="form-item">
      <view class="label-wrap">
        <text class="form-label">是否公开</text>
        <text class="form-desc" wx:if="{{!lockPublic}}">公开后可被其他用户使用，关闭则是私有发布，仅自己可见</text>
        <text class="form-desc" wx:else>当前仅支持私有发布</text>
      </view>
      <switch
        class="form-switch"
        checked="{{isPublic}}"
        disabled="{{lockPublic}}"
        bindchange="onPublicChange"
        color="#ffc107"
      />
    </view>

    <!-- 作品标签 -->
    <view class="form-item column">
      <text class="form-label">作品标签</text>
      <text class="form-desc">标签可用于被搜索，标签需要经过审核才有效</text>
      <view class="tag-wrap">
        <view class="tag-add" bindtap="addTag">
          <text>+ 添加标签</text>
        </view>
        <view class="tag-item" wx:for="{{tagList}}" wx:key="*this">
          <text>{{item}}</text>
          <text class="tag-close" bindtap="removeTag" data-index="{{index}}">×</text>
        </view>
      </view>
    </view>

    <!-- 自定义水印 -->
    <view class="form-item column">
      <view class="label-row">
        <text class="form-label">自定义水印</text>
        <switch class="form-switch" checked="{{useWatermark}}" bindchange="onWatermarkChange" color="#ffc107" />
      </view>
      <text class="form-desc">水平开启后，会显示在图纸中</text>
      <input class="form-input watermark-input" placeholder="请输入水印文字" value="{{watermark}}" bindinput="onWatermarkInput" />
    </view>

    <!-- 允许他人二创 -->
    <view class="form-item">
      <view class="label-wrap">
        <text class="form-label">允许他人二创</text>
        <text class="form-desc">开启后其他用户可复制该作品进行二次创作、发布等</text>
      </view>
      <switch class="form-switch" checked="{{allowDerivative}}" bindchange="onDerivativeChange" color="#ffc107" />
    </view>
  </view>

  <!-- 底部立即发布按钮 -->
  <view class="bottom-wrap">
    <view class="publish-btn {{publishing?'disabled':''}}" bindtap="publish">
      <text class="publish-icon">✓</text>
      <text>{{_editingId ? '立即更新' : '立即发布'}}</text>
    </view>
  </view>
</view>