page {
  height: 100%;
  background: #f9f5e9;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-wrap {
  flex-shrink: 0;
  background: #fff;
}
.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}
.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.nav-space {
  width: 60rpx;
}

/* 步骤条 */
.step-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  background: #fff;
  flex-shrink: 0;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.step-circle.done {
  background: #4caf50;
  color: #fff;
}
.step-circle.active {
  background: #ffc107;
  color: #fff;
}
.step-text {
  font-size: 22rpx;
  color: #999;
}
.step-text.active {
  color: #333;
  font-weight: 500;
}
.step-line {
  flex: 1;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 8rpx;
  margin-bottom: 28rpx;
  max-width: 80rpx;
}
.step-line.done {
  background: #4caf50;
}

/* 图片预览区域 */
.preview-area {
  width: 686rpx;
  aspect-ratio: 1 / 1;
  margin: 24rpx auto;
  background: #fff;
  border: 4rpx solid #4a90d9;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
}
.upload-text {
  font-size: 28rpx;
  color: #999;
}

/* 核心：去掉 transform，用绝对定位 */
.preview-img {
  position: absolute;
  top: 0;
  left: 0;
  transition: width 0.1s ease-out, height 0.1s ease-out, left 0.1s ease-out, top 0.1s ease-out;
}

/* 格子网格层 */
.grid-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  background-image:
    linear-gradient(to right, rgba(74,144,217,0.5) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(74,144,217,0.5) 1px, transparent 1px);
  z-index: 10;
}

/* 操作按钮 */
.action-btns {
  display: flex;
  gap: 24rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}
.action-btn {
  flex: 1;
  height: 80rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
  border: 1rpx solid #eee;
}
.action-btn:active {
  background: #f5f5f5;
}

/* 对齐格子 */
.align-section {
  padding: 0 24rpx;
  flex-shrink: 0;
}
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.tip-text {
  font-size: 24rpx;
  color: #ff9800;
  background: #fff8e1;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.align-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.align-btn {
  height: 80rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #eee;
}
.align-btn:active {
  background: #f0f0f0;
}
.arrow-icon {
  font-size: 32rpx;
  color: #333;
}
.align-center {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

/* 底部按钮 */
.bottom-wrap {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
.convert-btn {
  height: 96rpx;
  background: #ffd54f;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  gap: 12rpx;
}
.convert-btn:active {
  background: #ffc107;
}
.convert-btn.disabled {
  opacity: 0.5;
}
.convert-icon {
  font-size: 28rpx;
}