page{
    height:100%;
    background:#f9f5e9;
}
.page{
    min-height:100%;
    display:flex;
    flex-direction:column;
}
/* 导航栏 */
.nav-wrap{
    flex-shrink:0;
    background:#fff;
}
.nav-bar{
    display:flex;
    align-items:center;
    height:88rpx;
    padding:0 24rpx;
}
.back-btn{
    width:60rpx;
    height:60rpx;
    display:flex;
    align-items:center;
    justify-content:center;
}
.back-icon{
    font-size:48rpx;
    color:#333;
    font-weight:300;
}
.nav-title{
    flex:1;
    text-align:center;
    font-size:34rpx;
    font-weight:bold;
    color:#333;
}
.nav-space{
    width:60rpx;
}
/* 上传区域 */
.upload-area{
    margin:24rpx;
    height:500rpx;
    background:#fff;
    border-radius:16rpx;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
}
.camera-icon{
    width:120rpx;
    height:120rpx;
    margin-bottom:24rpx;
}
.upload-text{
    font-size:28rpx;
    color:#999;
}
.preview-img{
    width:100%;
    height:100%;
    border-radius:16rpx;
}
/* 操作按钮 */
.action-btns{
    display:flex;
    gap:24rpx;
    padding:0 24rpx;
    margin-bottom:32rpx;
}
.action-btn{
    flex:1;
    height:80rpx;
    background:#fff;
    border-radius:12rpx;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28rpx;
    color:#333;
    border:1rpx solid #eee;
}
.action-btn:active{
    background:#f5f5f5;
}
/* 转换配置 */
.config-section{
    padding:0 24rpx;
    flex:1;
}
.config-title{
    font-size:30rpx;
    font-weight:bold;
    color:#333;
    margin-bottom:16rpx;
    display:block;
}
.config-list{
    background:#fff;
    border-radius:16rpx;
    overflow:hidden;
}
.config-item{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:28rpx 24rpx;
    border-bottom:1rpx solid #f5f5f5;
}
.config-item:last-child{
    border-bottom:none;
}
.config-label{
    font-size:28rpx;
    color:#333;
}
.config-right{
    display:flex;
    align-items:center;
}
.config-value{
    font-size:28rpx;
    color:#999;
    margin-right:8rpx;
}
.arrow{
    font-size:32rpx;
    color:#ccc;
}
/* 底部按钮 */
.bottom-wrap{
    padding:24rpx;
    padding-bottom:calc(24rpx + env(safe-area-inset-bottom));
}
.convert-btn{
    height:96rpx;
    background:#ffd54f;
    border-radius:48rpx;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:32rpx;
    font-weight:bold;
    color:#333;
    gap:12rpx;
}
.convert-btn:active{
    background:#ffc107;
}
.convert-btn.disabled{
    opacity:0.5;
}
.convert-icon{
    font-size:28rpx;
}
