<!-- 12 常用色：常驻显示在工具栏下方，不需要点击切换 -->
<view class="color-picker {{isDarkMode?'dark':''}}">
  <view class="current-color-box">
    <view class="color-block-large" style="background:{{currentColor}};"></view>
    <view class="color-info">
      <text class="color-label">当前颜色</text>
      <text class="color-code">{{currentColorName || '自定义'}}</text>
    </view>
  </view>

  <view class="color-grid">
    <view
      wx:for="{{colorList}}"
      wx:key="code"
      class="color-item {{currentColor===item.color?'active':''}}"
      bindtap="onSelect"
      data-color="{{item.color}}"
      data-code="{{item.code}}"
    >
      <view class="color-block" style="background:{{item.color}};">
        <view class="check-wrap" wx:if="{{currentColor===item.color}}">
          <text class="check-icon">✓</text>
        </view>
      </view>
      <text class="color-name">{{item.code}}</text>
    </view>
  </view>
</view>
