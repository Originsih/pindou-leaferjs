.lib-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
}

.lib-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50vh;
  background: #fff;
  border-radius: 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  box-sizing: border-box;
}

.lib-popup.show {
  transform: translateY(0);
}

/* 分类 tab */
.group-tabs {
  width: 100%;
  white-space: nowrap;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  box-sizing: border-box;
}

.tab-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.tab-item.active {
  background: #ff6b35;
  color: #fff;
  font-weight: bold;
}

/* 颜色网格 */
.lib-color-list {
  flex: 1;
  width: 100%;
  padding: 20rpx 24rpx 40rpx 24rpx;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
}

.lib-color-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  box-sizing: border-box;
}

.lib-color-item {
  width: 16.6666%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 6rpx 20rpx 6rpx;
  box-sizing: border-box;
}

.lib-color-block {
  width: 100%;
  padding-top: 100%;
  position: relative;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 8rpx;
  box-sizing: border-box;
}

.lib-color-item.active .lib-color-block {
  box-shadow: inset 0 0 0 4rpx #ff6b35, 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.lib-check-wrap {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lib-check-icon {
  color: #ff6b35;
  font-size: 26rpx;
  font-weight: bold;
}

.lib-color-name {
  font-size: 20rpx;
  color: #333;
  text-align: center;
}

/* 黑夜模式 */
.lib-popup.dark {
  background: #1e1e1e;
}

.lib-popup.dark .group-tabs {
  border-bottom-color: #333;
}

.lib-popup.dark .tab-item {
  background: #2a2a2a;
  color: #aaa;
}

.lib-popup.dark .tab-item.active {
  background: #ff6b35;
  color: #fff;
}

.lib-popup.dark .lib-color-name {
  color: #aaa;
}

.lib-popup.dark .lib-color-block {
  box-shadow: 0 0 0 2rpx #333;
}

.lib-popup.dark .lib-color-item.active .lib-color-block {
  box-shadow: inset 0 0 0 4rpx #ff6b35, 0 0 0 2rpx #333;
}

.lib-popup.dark .lib-check-wrap {
  background: rgba(30, 30, 30, 0.9);
}