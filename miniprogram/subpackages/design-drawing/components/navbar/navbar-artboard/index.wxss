.nav-wrap {
    width: 100%;
    box-sizing: border-box;
}
.nav-bar {
    display: flex;
    align-items: center;
    height: 88rpx;
    width: 100%;
    box-sizing: border-box;
    gap: 16rpx;
}
.back-btn {
    margin-left: 16rpx;
    text-align: center;
    flex-shrink: 0;
}
.back-icon{
    width: 28rpx;
    height: 24rpx;
}

.nav-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    border:1rpx solid #ddd;
    border-radius:12rpx;
    flex-shrink:0;
    height:56rpx;
    background:#fff;
}
.size-btn{
    width:116rpx;
    height: 48rpx;
    font-size:26rpx;
    color:#333;
    font-weight:500;
    white-space:nowrap;
}
.icon-btn{
    width:48rpx;
    height: 48rpx;
    font-size:32rpx;
}
.text-btn{
    width:128rpx;
    height: 48rpx;

    font-size:28rpx;
    color:#333;
}
.nav-space {
    flex:1;
    min-width:160rpx;
}
/* 黑夜模式 */
.nav-bar.dark .nav-btn {
  background: #2a2a2a;
  color: #eee;
}

.nav-bar.dark .size-btn {
  border-color: #444;
  background: #2a2a2a;
  color: #eee;
}

.nav-bar.dark .text-btn {
  background: #2a2a2a;
  color: #eee;
}

.nav-bar.dark .icon-btn {
  background: #2a2a2a;
}

.nav-bar.dark .back-icon,
.nav-bar.dark .back-icon-img {
  filter: brightness(0) invert(1);
}