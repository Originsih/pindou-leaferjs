.bottom-toolbar {
    display: flex;
    align-items: flex-end;
    background: #fff;
    padding: 16rpx 24rpx 20rpx;
    border-top: 1rpx solid #eee;
    gap: 32rpx;
    margin-top: 26rpx;
  }
  
  .brush-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  
  .brush-size {
    display: flex;
    align-items: center;
    background: rgba(242, 242, 242, 1);
    border-radius: 12rpx;
    padding: 8rpx 12rpx;
    margin-bottom: 8rpx;
  }
  
  .size-btn {
    width: 48rpx;
    height: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    color: #333;
    border-radius: 8rpx;
    background-color: rgba(255, 255, 255, 1);
  }
  
  .size-btn:active {
    background: #e0e0e0;
  }
  
  .size-num {
    font-size: 28rpx;
    color: #333;
    min-width: 48rpx;
    text-align: center;
    font-weight: 500;
  }
  
  .brush-label {
    font-size: 22rpx;
    color: #666;
  }
  
  .tool-scroll {
    flex: 1;
    white-space: nowrap;
  }
  
  .tool-list {
    display: inline-flex;
    gap: 18rpx;
  }
  
  .tool-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding:8rpx;
    flex-shrink: 0;
    background: transparent;
    border: none;
  }
  
  /* 图标包裹层：背景色只在这层 */
  .tool-icon-wrap {
    width: 52rpx;
    height: 52rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16rpx;
    background: #f5f5f5;
    margin-bottom: 6rpx;
    transition: background 0.2s;
  }
  
  .tool-item:active .tool-icon-wrap {
    background: #e8e8e8;
  }
  
  .tool-item.active .tool-icon-wrap {
    background: #ffd54f;
  }
  
  .tool-item.active:active .tool-icon-wrap {
    background: #ffc107;
  }
  
  /* 图标：固定尺寸，不要让它撑开包裹层 */
  .tool-icon-img {
    width: 52rpx;
    height: 52rpx;
    display: block;
  }
  
  .tool-name {
    font-size: 22rpx;
    color: #666;
    line-height: 1.4;
  }
  
  .tool-item.active .tool-name {
    color: #333;
  }

  /* 黑夜模式 */
  .bottom-toolbar.dark {
    background: #1e1e1e;
    border-top-color: #333;
  }
  .bottom-toolbar.dark .brush-size {
    background: #2a2a2a;
  }
  .bottom-toolbar.dark .size-btn {
    color: #ddd;
  }
  .bottom-toolbar.dark .size-num {
    color: #ddd;
  }
  .bottom-toolbar.dark .brush-label {
    color: #aaa;
  }
  .bottom-toolbar.dark .tool-icon-wrap {
    background: #2a2a2a;
  }
  .bottom-toolbar.dark .tool-name {
    color: #aaa;
  }
  .bottom-toolbar.dark .tool-item.active .tool-icon-wrap {
    background: #ffd54f;
  }