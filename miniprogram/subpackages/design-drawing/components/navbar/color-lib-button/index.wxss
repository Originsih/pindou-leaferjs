.color-lib-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.color-lib-btn.dark {
  background: #2a2a2a;
}

.color-lib-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
}

.color-lib-btn.dark .color-lib-dot {
  border-color: #444;
}

.color-lib-text {
  font-size: 26rpx;
  color: #333;
}

.color-lib-btn.dark .color-lib-text {
  color: #eee;
}